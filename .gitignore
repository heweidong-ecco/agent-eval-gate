# OS / 编辑器
.DS_Store
*.swp
.idea/
.vscode/

# 环境与密钥(永远不入库)
.env
.env.*
!.env.example
node_modules/
venv/
.venv/
__pycache__/
*.py[cod]

# 构建产物
dist/
build/
*.log

# 运行时数据(评估运行记录本地保留,提交摘要即可)
eval/runs/*.local.json
eval/runs/*.trace.jsonl

# 被测自证文件(run_sut.sh 每次运行重新生成 ⇒ 提交只会产生噪音;
# 它是"当前被 serve 的代码是谁"的**本地**交接物,不是某次评测的产物)
eval/runs/.sut-harness.env

# 观测本地后端数据(如 Phoenix/Jaeger 本地存储)
observability/.local/
*.db
*.sqlite3

# 本地脚手架生成的样例(不入库;样例项目单独建仓)
scaffold/_generated/

# 避坑库变动检测的状态文件(每台机器各自维护)
.claude/.kb-avoid-manifest

# Python 构建产物(pip install -e . 生成)
*.egg-info/

# 覆盖率产物(pytest-cov;本机数据,不入库)
.coverage
.coverage.*
htmlcov/
coverage.xml

# skill 调用 trace(本机本会话事实,不入库)
.claude/traces/
