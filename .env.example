# agent-eval-gate 评测门 judge 凭证(可选;不设 = 仅确定性规则/离线 fake 跑)
# judge 走任意 OpenAI 兼容端点(DEC-002)。切 DeepSeek 官方示例:
# EVAL_JUDGE_BASE_URL=https://api.deepseek.com/v1
# EVAL_JUDGE_API_KEY=sk-xxx
# EVAL_JUDGE_MODEL=deepseek-v4-flash    # 官方 2026-07-24 起 deepseek-chat/reasoner 已停用
# EVAL_JUDGE_MAX_TOKENS=4096
#   ⚠️ 推理型模型(deepseek-v4-*)的 reasoning_tokens 与 content **共用**该上限:
#      设小了(如 512),难例的推理会先吃满 → finish_reason='length' → content 为空
#      → 判分器解析不出 JSON → flag → exit 2。这不是"模型不听话",是预算不够。
#      实测:512 下难例两次尝试全截断;3072 起 4/4 一次成功(2026-09-12,DEC-006)。
# EVAL_JUDGE_CONCURRENCY=4

# 真实被测(01.FastAPI RAG Agent)接入配置(fastapi-rag 适配器用)
# ⚠️ 用 127.0.0.1 而非 localhost:若本机 Docker 的 userland proxy 占了 ::1:8000
#    (例如同端口有个崩溃重启的容器),localhost 解析到 IPv6 会得到
#    "Connection reset by peer"。R1b 实测踩过。
# EVAL_SUT_FASTAPI_BASE_URL=http://127.0.0.1:8000
# EVAL_SUT_FASTAPI_API_KEY=sk-xxx          # 被测 admin API Key(X-API-Key 头;非登录口令)

# 取法(总纲 D-5:HTTP/快照/回放);指向快照文件则走快照回放,留空=HTTP
# EVAL_SUT_FASTAPI_SNAPSHOT=eval/snapshots/fastapi_rag_2026-06-29.json

# TLS:若本机有 TLS 拦截(企业代理/安全软件),其 CA 只在系统信任库,
# venv 默认 CA 集合里没有 → judge 会 CERTIFICATE_VERIFY_FAILED 全挂。
# macOS 指向系统 bundle 即可;备选:certifi 的 cacert.pem
# SSL_CERT_FILE=/etc/ssl/cert.pem

# 真模型/真实被测冒烟开关:设 1 后 tests/test_live_smoke.py 才跑(默认 skip)
# EVAL_LIVE=1
