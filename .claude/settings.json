{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "IMPL_GUARD=1 .claude/hooks/impl-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KIT_SENTINEL=1 .claude/hooks/kit-sentinel.sh"
          },
          {
            "type": "command",
            "command": "FAILURE_SENTINEL=1 .claude/hooks/failure-sentinel.sh"
          },
          {
            "type": "command",
            "command": "SKILL_SENTINEL=1 .claude/hooks/skill-sentinel.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KB_SENTINEL=1 .claude/hooks/kb-drift-sentinel.sh"
          },
          {
            "type": "command",
            "command": "SESSION_CTX=1 .claude/hooks/session-context.sh"
          }
        ]
      }
    ]
  }
}
